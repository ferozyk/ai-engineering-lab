# Copy to .env and fill in values. Never commit .env.
# None of these are required to install the project or run the default test suite.

# --- LLM provider ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter
# Model identifier from your provider (e.g. an OpenRouter model id). Intentionally left blank:
# free-model availability changes, so choose one explicitly.
LLM_MODEL=
LLM_TEMPERATURE=0

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
